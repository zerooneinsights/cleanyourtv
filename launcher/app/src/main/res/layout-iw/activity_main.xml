<?xml version="1.0" encoding="utf-8"?>
<!-- Hebrew-only header positioning. Other languages use layout/activity_main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Home's slate backdrop (home_backdrop), under everything else. -->
    <View
        android:id="@+id/homeBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_backdrop"
        android:importantForAccessibility="no" />

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden).
         Keep in step with layout/activity_main.xml: every view there must exist here too. -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend), mirrored: under the clock on the right. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|right"
        android:layout_marginEnd="60dp"
        android:layout_marginTop="158dp"
        android:gravity="right"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />

            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginStart="10dp"
                android:id="@+id/raceBar"
                android:background="@drawable/race_bar" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12" />

        <!-- game_day: one dot per turn when the panel rotates between games (and the F1 weekend). -->
        <LinearLayout
            android:id="@+id/racePager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Home widgets. Top: the news card (as tall as the column beside it, set in code) and, beside it, the live
         cricket card over the calendar. Below: the commute card and the markets card (the indices over each other,
         the returns table beside them). -->
    <LinearLayout
        android:id="@+id/homeWidgets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="86dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no">

        <LinearLayout
            android:id="@+id/widgetsTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

        <LinearLayout
                android:id="@+id/newsCard"
                android:layout_width="440dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rightWidgets"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

    <!-- Live cricket (CricketCard): one line like the weather, above the calendar, only while a followed match is
                 live. The full scorecard is the top bar's scorecard drop-down. -->
            <TextView
                android:id="@+id/cricketCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/widget_card"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#F2FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@string/font_regular"
                android:visibility="gone" />

    <!-- Calendar card (AgendaPanel), shown only when show_agenda is on and READ_CALENDAR is granted: today's and
                 tomorrow's events, and this month as a small grid, under the top buttons. Selectable: OK syncs it now. -->
            <LinearLayout
                android:id="@+id/calendarBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_card_focus"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:visibility="gone"
                android:focusable="true"
                android:clickable="true"
                android:importantForAccessibility="no">
    
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="18dp"
                    android:orientation="vertical">
    
                    <TextView
                        android:id="@+id/agendaPanel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="150dp"
                        android:maxWidth="215dp"
                        android:maxLines="9"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#E6FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@string/font_regular" />
    
                </LinearLayout>
    
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
    
                    <TextView
                        android:id="@+id/calendarMonth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:letterSpacing="0.14"
                        android:fontFamily="@string/font_medium" />
    
                    <com.gathin.tvhome.MonthGridView
                        android:id="@+id/calendarGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />
    
                    <!-- "Updated 11:05", or "Syncing…" during a manual refresh (OK on this card), under the month. -->
                    <TextView
                        android:id="@+id/calendarStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="end"
                        android:textColor="#66FFFFFF"
                        android:textSize="6sp"
                        android:fontFamily="@string/font_regular" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

    <!-- Commute (CommuteLine, config.xml show_commute): both ways in today's traffic. Hidden in code unless
                     commute.url (or commute.key) is set in local.properties. -->
                <LinearLayout
                    android:id="@+id/commuteCard"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:background="@drawable/widget_card"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">
    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
    
                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_car"
                            android:tint="#D9FFFFFF"
                            android:importantForAccessibility="no" />
    
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Commute"
                            android:singleLine="true"
                            android:textColor="#F2FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@string/font_medium"
                            android:includeFontPadding="false" />
    
                    </LinearLayout>
    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
    
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
    
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/commute_label"
                                android:singleLine="true"
                                android:textColor="#B3FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@string/font_regular"
                                android:includeFontPadding="false" />
    
                            <TextView
                                android:id="@+id/commute"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="…"
                                android:lineSpacingExtra="1dp"
                                android:textColor="#D9FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@string/font_regular"
                                android:includeFontPadding="false" />
                        </LinearLayout>
    
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="10dp"
                            android:background="#24FFFFFF" />
    
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
    
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/commute_label_back"
                                android:singleLine="true"
                                android:textColor="#B3FFFFFF"
                                android:textSize="10sp"
                                android:fontFamily="@string/font_regular"
                                android:includeFontPadding="false" />
    
                            <TextView
                                android:id="@+id/commuteBack"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:text="…"
                                android:lineSpacingExtra="1dp"
                                android:textColor="#D9FFFFFF"
                                android:textSize="11sp"
                                android:fontFamily="@string/font_regular"
                                android:includeFontPadding="false" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            <!-- Markets: the indices (MarketTicker) over each other, then the returns table (ReturnsCard). -->
            <LinearLayout
                android:id="@+id/marketCard"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/ticker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <View
                    android:id="@+id/marketDivider"
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="14dp"
                    android:background="#24FFFFFF" />

                <LinearLayout
                    android:id="@+id/returnsCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="68dp"
        android:layout_gravity="right"
        android:gravity="right"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:gravity="right"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_gravity="right"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="6dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- No clipping down to the pills: with advanced effects a focused pill scales up past its row. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_toEndOf="@+id/topButtons"
                android:layout_marginStart="16dp"
                android:orientation="horizontal"
                android:gravity="right|bottom">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="9dp"
                    android:orientation="vertical">

                    <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#E6FFFFFF"
                        android:textSize="17sp"
                        android:fontFamily="@string/font_regular"
                        android:letterSpacing="0.02"
                        android:includeFontPadding="false"
                        android:visibility="gone" />

                    <!-- Weather (WeatherLine), shown when show_weather is on: icon, temperature, today's high and low. -->
                    <TextView
                        android:id="@+id/weather"
                        android:gravity="right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:singleLine="true"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@string/font_regular"
                        android:includeFontPadding="false"
                        android:visibility="gone" />

                    <TextClock
                        android:id="@+id/date"
                        android:gravity="right"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:format12Hour="@string/date_format"
                        android:format24Hour="@string/date_format"
                        android:textColor="#A6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@string/font_regular"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true" />

                        <!-- Lunar date ("Lunar 13/9 · Year of the Horse"), shown when lunar_date is on. -->
                        <TextView
                            android:id="@+id/lunarDate"
                            android:gravity="right"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true"
                            android:visibility="gone" />
                </LinearLayout>

                <View
                    android:id="@+id/clockDivider"
                    android:layout_width="1dp"
                    android:layout_height="26dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/greeting"
                        android:gravity="center_horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:ellipsize="end"
                        android:textColor="#8CFFFFFF"
                        android:textSize="12sp"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0"
                        android:textAllCaps="true" />

                <!-- The date above the time ("Fri, 20-Nov"). -->
                <TextClock
                    android:id="@+id/dateTop"
                    android:gravity="right"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="2dp"
                    android:singleLine="true"
                    android:format12Hour="EEEE, dd-MMM"
                    android:format24Hour="EEEE, dd-MMM"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@string/font_regular"
                    android:includeFontPadding="false" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">
                        <!-- Seconds over AM/PM, beside the flip clock. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_gravity="center_vertical"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <com.gathin.tvhome.FlipClockView
                            android:id="@+id/seconds"
                            android:tag="seconds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:singleLine="true"
                            android:textDirection="rtl"
                                                                                    android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#B3FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@string/font_medium"
                            android:letterSpacing="0"
                            android:ellipsize="none"
                            android:textAllCaps="true" />
                    </LinearLayout>

                        <TextClock
                            android:id="@+id/clock"
                        android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FFFFFFFF"
                            android:textSize="42sp"
                            android:fontFamily="@string/font_light"
                            android:letterSpacing="-0.04"
                            android:fontFeatureSettings="tnum"
                            android:includeFontPadding="false" />

                    <!-- The flip clock (FlipClockView); the plain clock above stays for the header's layout code. -->
                    <com.gathin.tvhome.FlipClockView
                        android:id="@+id/flipClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

            <!-- Shown only when show_stats is on. Outside leftBlock, so the top buttons stay level with the clock
                 row; gone, it takes no space. -->
            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:layout_alignEnd="@id/leftBlock"
                android:gravity="right"
                android:textDirection="rtl"
                android:layout_marginEnd="6dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <!-- Opens CalendarActivity; shown when show_agenda is on. -->
                <TextView
                    android:id="@+id/btnCalendar"
                    style="@style/TopButton"
                    android:visibility="gone"
                    android:text="@string/calendar"
                    android:drawableStart="@drawable/ic_calendar"
                    android:nextFocusDown="@+id/grid" />

                <!-- Shows and hides Home's subscriptions card; shown when show_subscriptions is on. -->
                <TextView
                    android:id="@+id/btnSubscriptions"
                    style="@style/TopButton"
                    android:visibility="gone"
                    android:text="@string/subscriptions"
                    android:drawableStart="@drawable/ic_subscriptions"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnVpn"
                    style="@style/TopButton"
                    android:visibility="gone"
                    android:singleLine="true"
                    android:text="@string/vpn"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnLibraryTop"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/app_library"
                    android:drawableStart="@drawable/ic_apps"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <!-- Drops down the cricket scorecard (CricketScorecard); shown when show_scorecard is on. -->
                <TextView
                    android:id="@+id/btnScorecard"
                    style="@style/TopButton"
                    android:visibility="gone"
                    android:text="@string/scorecard"
                    android:drawableStart="@drawable/ic_cricket"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <!-- Cricket scorecard (CricketScorecard, config.xml show_scorecard): dropped down below the top bar's scorecard
         button like the subscriptions card; moving focus off it closes it. Rows are added in code. -->
    <LinearLayout
        android:id="@+id/scorecardCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_card_focus"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minWidth="300dp"
        android:focusable="true"
        android:visibility="gone" />

    <!-- Subscriptions (Subscriptions, config.xml show_subscriptions): days until each one expires. Hidden until
         the top bar's subscriptions button is pressed; then MainActivity drops it down just below that button, over
         the other cards. OK opens SubscriptionsActivity; moving focus off it hides it again. -->
    <TextView
        android:id="@+id/subscriptionsCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:background="@drawable/widget_card_focus"
        android:elevation="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minWidth="260dp"
        android:maxWidth="400dp"
        android:maxLines="8"
        android:ellipsize="end"
        android:gravity="start"
        android:lineSpacingExtra="3dp"
        android:textColor="#F2FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@string/font_regular"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone" />

    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- MorePage: a second page under Home, slid in by Down from the app row. -->
    <ScrollView
        android:id="@+id/morePage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone" />
</FrameLayout>
